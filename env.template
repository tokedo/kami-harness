# Copy this file to ~/.blocklife-keys/.env and fill in your keys.
# This file must NOT be inside the repo — Claude Code auto-indexes
# the project directory and could read it on startup.
# Location: ~/.blocklife-keys/.env (override with KAMI_KEYS_FILE)
#
# Entries whose names look like secrets ({LABEL}_OWNER_KEY,
# {LABEL}_OPERATOR_KEY, *_KEY, *_TOKEN, *_SECRET, *_PRIVY_ID, PRIVY_ID)
# are read into the server process ONLY. They are deliberately NOT
# exported to the process environment, so a child process cannot inherit
# them. Everything else here (RPC_URL, MAINNET_RPC_URL, the flags below)
# IS exported, exactly as before.
#
# Per-account private keys. Label must match accounts/roster.yaml.
# Format: {LABEL}_OPERATOR_KEY and {LABEL}_OWNER_KEY (label uppercased)
# Add as many accounts as you manage. A new account may start with only
# {LABEL}_OWNER_KEY: the create_operator_wallet tool generates the
# operator keypair in the server process and writes {LABEL}_OPERATOR_KEY
# here itself.

MAIN_OPERATOR_KEY=
MAIN_OWNER_KEY=

# Uncomment and add more accounts as needed:
# FARM1_OPERATOR_KEY=
# FARM1_OWNER_KEY=

# Yominet RPC (default works, override if needed)
RPC_URL=https://jsonrpc-yominet-1.anvil.asia-southeast.initia.xyz

# Ethereum mainnet RPC — REQUIRED, no default. Used by the bridge tools
# (bridge_eth_from_mainnet quoting/signing, gas estimation). The endpoint
# is part of the environment definition and is recorded in run manifests;
# the server fails at startup when it is unset.
MAINNET_RPC_URL=

# The following are populated automatically by the MCP server during
# initialization (register_kamibots tool). Do NOT fill manually.
# Per-account: {LABEL}_KAMIBOTS_API_KEY and {LABEL}_PRIVY_ID
# MAIN_KAMIBOTS_API_KEY=
# MAIN_PRIVY_ID=

# --- secret store ---
# Where the server reads and writes the names above. Both backends are
# optional configuration; a deployment that sets none of this behaves
# exactly as every earlier version did.
#
# KAMI_KEYS_FILE        this file's path (default ~/.blocklife-keys/.env)
# KAMI_SECRETS_BACKEND  envfile (DEFAULT — this file) | keychain (macOS
#                       login Keychain, generic-password items
#                       kami-mcp/<NAME>, account = login user)
# KAMI_SECRETS_MANIFEST names-only list (one per line, NO values) of the
#                       names the keychain backend protects. Default: this
#                       file's name with a trailing ".env" removed plus
#                       ".secrets.names", alongside it — so
#                       ~/.blocklife-keys/.env -> ~/.blocklife-keys/.secrets.names.
#                       No manifest = nothing protected = no Keychain call.
# ALLOW_ENV_SECRETS=1   let a protected name fall back to this file / the
#                       process environment (warned on stderr, names only)
# KAMI_SECRETS_VERBOSE=1  list Keychain-sourced names in the startup report
#
# Secret VALUES never reach stdout, tool results, or error text under any
# of these settings — names and locations only.
# KAMI_SECRETS_BACKEND=envfile

# --- kami-lens (world-state daemon) ---
# World-state READ tools are wrappers over the local kami-lens daemon.
# The lens release this server version is built against is declared in
# SPEC.md D1. Socket path defaults to the daemon's platform data dir
# (<dataDir>/kami-lens.sock); override here.
# KAMI_LENS_SOCKET=

# How lens answers are presented: envelope (default) | name-free
# (daemon withholds player-authored name strings with receipt) |
# inline-tags (declared; not implemented at this version — selecting it
# fails at startup).
# PRESENTATION_MODE=envelope

# Chat tools (lens_chat; chat send lands in a later version): present in
# the registry regardless, but answer CHAT_DISABLED unless enabled here.
# KAMI_CHAT_ENABLED=false

# --- error results ---
# Mechanics snippets on ERROR results. When on, a failed call's error
# message gains an appended "[mechanics] ..." block built from the
# server's own precondition gates and gas-ceiling registry: the state it
# read, the tools whose state gate accepts that state, what the attempted
# tool requires, and the gas ceiling the call provisioned. States, tool
# names and numbers only — no advice. Error text only: the tool surface
# (count, descriptions, schemas, tools_hash) is identical either way.
# KAMI_ERROR_SNIPPETS=false
